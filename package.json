{
  "name": "@mrlyprod/net",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "wasm": "MRLY_ROOT=$PWD bun run --cwd ../ui wasm --copy",
    "dev": "MRLY_ROOT=$PWD bun run --cwd ../ui dev",
    "build": "MRLY_ROOT=$PWD bun run --cwd ../ui build",
    "push": "MRLY_ROOT=$PWD bun run --cwd ../ui push",
    "shots": "MRLY_ROOT=$PWD bun run --cwd ../ui shots",
    "mrlynet": "bun ../os/doors/cli/cli.ts",
    "lint": "biome ci .",
    "fix": "biome check --write .",
    "types": "tsc -p tsconfig.json",
    "content": "MRLY_ROOT=$PWD bun run --cwd ../ui content"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "typescript": "^7.0.2"
  }
}
